---
layout: default
---
{% comment %}
  Profile-style CV page (logo + dates column, clean section list).
  Data: _data/cv.yml -> cv.sections (Education, Experience, Publications, Teaching, Academic Service, Skills).
{% endcomment %}
{% assign sections = site.data.cv.cv.sections %}

<div class="post cv-profile">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    {% if page.cv_pdf %}
      <a
        class="cvp-pdf"
        {% if page.cv_pdf contains '://' %}
          href="{{ page.cv_pdf }}"
        {% else %}
          href="{{ page.cv_pdf | relative_url }}"
        {% endif %}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-solid fa-file-pdf"></i> Download PDF
      </a>
    {% endif %}
  </header>

  <article>
    {% if sections.Education %}
      <section class="cvp-section" id="education">
        <h2 class="cvp-heading">Education</h2>
        {% for e in sections.Education %}
          <div class="cvp-row">
            <div class="cvp-side">
              {% if e.logo %}
                <img class="cvp-logo" src="{{ e.logo | prepend: '/assets/img/' | relative_url }}" alt="{{ e.institution }}">
              {% endif %}
              <div class="cvp-date">{{ e.dates | replace: ' – ', ' –<br>' }}</div>
            </div>
            <div class="cvp-main">
              <div class="cvp-title">{{ e.degree }}, {{ e.institution }}, {{ e.location }}</div>
              <div class="cvp-sub">{{ e.area }}</div>
              {% for h in e.highlights %}
                <div class="cvp-sub">{{ h | markdownify | remove: '<p>' | remove: '</p>' | strip }}</div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if sections.Experience %}
      <section class="cvp-section" id="experience">
        <h2 class="cvp-heading">Research Experience</h2>
        {% for x in sections.Experience %}
          <div class="cvp-row">
            <div class="cvp-side">
              {% if x.logo %}
                <img class="cvp-logo" src="{{ x.logo | prepend: '/assets/img/' | relative_url }}" alt="{{ x.company }}">
              {% endif %}
              <div class="cvp-date">{{ x.dates | replace: ' – ', ' –<br>' }}</div>
            </div>
            <div class="cvp-main">
              <div class="cvp-title">{{ x.company }}</div>
              <div class="cvp-sub">{{ x.position }}</div>
              {% if x.advisors %}
                <div class="cvp-sub">{{ x.advisors | markdownify | remove: '<p>' | remove: '</p>' | strip }}</div>
              {% endif %}
              {% if x.highlights %}
                <ul class="cvp-bullets">
                  {% for h in x.highlights %}
                    <li>{{ h | markdownify | remove: '<p>' | remove: '</p>' | strip }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if sections.Publications %}
      <section class="cvp-section" id="publications">
        <h2 class="cvp-heading">Publications</h2>
        <p class="cvp-hint">† equal contribution</p>
        {% for p in sections.Publications %}
          <div class="cvp-list-row">
            <div class="cvp-year">{{ p.date }}</div>
            <div class="cvp-main">
              <div class="cvp-pub-title">
                {% if p.url %}<a href="{{ p.url }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}
              </div>
              <div class="cvp-sub">{{ p.summary | markdownify | remove: '<p>' | remove: '</p>' | strip }}</div>
              <div class="cvp-venue">{{ p.publisher }}</div>
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if sections.Teaching %}
      <section class="cvp-section" id="teaching">
        <h2 class="cvp-heading">Teaching</h2>
        {% for t in sections.Teaching %}
          <div class="cvp-block">
            <div class="cvp-label">{{ t.dates }}</div>
            <div class="cvp-title">{{ t.position }}</div>
            <div class="cvp-sub">{{ t.organization }}. {{ t.summary }}</div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if sections['Academic Service'] %}
      <section class="cvp-section" id="service">
        <h2 class="cvp-heading">Professional Service</h2>
        {% for sv in sections['Academic Service'] %}
          <div class="cvp-block">
            <div class="cvp-label">{{ sv.label }}</div>
            <div class="cvp-text">{{ sv.details }}</div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if sections.Skills %}
      <section class="cvp-section" id="skills">
        <h2 class="cvp-heading">Skills</h2>
        {% for sk in sections.Skills %}
          <div class="cvp-block">
            <div class="cvp-label">{{ sk.name }}</div>
            <div class="cvp-text">{{ sk.keywords }}</div>
          </div>
        {% endfor %}
      </section>
    {% endif %}
  </article>
</div>
